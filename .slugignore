# Files to exclude from Heroku slug to reduce size

# Documentation (exclude .md files except in guides/ which is served by the app)
*.md
!README.md
!guides/*.md
docs/
# guides/ directory is NEEDED by the app for web UI

# Tests
tests/
test_*.py
*_test.py

# Visualizations (not needed in production)
visualizations/

# Development files
.vscode/
.idea/
.DS_Store
*.pyc
__pycache__/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Git
.git/
.gitignore
.gitattributes

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Development scripts
train_model.sh
start_dev.sh

# Docker (if not using container deployment)
Dockerfile
docker-compose.yml
.dockerignore

# Large data files (keep only essential datasets)
ml/data/raw/infra_copilot_intent_dataset_v1_1.jsonl
ml/data/raw/infra_copilot_intent_dataset_v3.jsonl

# Feedback data (will be written at runtime)
ml/data/feedback/*.jsonl

# Processed data (can be regenerated)
ml/data/processed/

# Saved models - ONLY exclude LLM models (huge), keep traditional ML models (small)
ml/model/saved_models/llm_*
ml/llm/__pycache__/
ml/traditional_ml/__pycache__/

# Keep these small traditional ML models (they're needed for inference):
# - tfidf_svm_model_*.pkl (~90-310KB)
# - intent_mapping_*.pkl (~1KB)
# - label_encoder_*.pkl (~1KB)

# Logs
logs/
*.log
server.log
server.pid

# Observability data (generated at runtime)
observability_data/
*.db

# Cache
.cache/
*.cache

# Virtual environment (Heroku creates its own)
venv/
env/
.venv/

# OS files
Thumbs.db
.DS_Store

