# Environment Variables for Intent Classification System
# Copy this file to .env and fill in your values

# Application Settings
DEBUG=false
PORT=8000
HOST=0.0.0.0

# LangSmith Configuration (Observability)
# Sign up at https://smith.langchain.com/ to get your API key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=intent-classification

# Database Configuration (if needed)
# DATABASE_URL=sqlite:///./backend/database/chat_sessions.db

# Model Configuration
# MODEL_TYPE=tfidf_svm

# CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
